generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique // For URL friendly ID
  title       String
  type        String
  location    String
  description String
  skills      String   // Stored as comma separated string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

model JobApplication {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String
  jobTitle    String
  resumePath  String
  coverLetter String?
  createdAt   DateTime @default(now())
}

model DemoRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  company   String?
  createdAt DateTime @default(now())
}
