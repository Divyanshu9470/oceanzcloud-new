# Local Development Database URL (PostgreSQL)
# Replace with your actual PostgreSQL connection string
# For local development, you can use:
# - Docker: docker run --name postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
# - Or install PostgreSQL locally

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oceanzcloud?schema=public"

# For production, Vercel will automatically inject the DATABASE_URL from the Vercel Postgres integration
